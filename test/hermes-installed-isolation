#!/bin/bash
set -euo pipefail

# Run as an ordinary user in an isolated Linux guest/container with the package installed.
(( EUID != 0 )) || { echo "Run this installed acceptance check as an ordinary user." >&2; exit 1; }
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/project/hermes_cli" "$work/hostile/hermes_cli"
printf '%s\n' 'raise RuntimeError("UNTRUSTED CWD MODULE LOADED")' > "$work/project/hermes_cli/__init__.py"
cp "$work/project/hermes_cli/__init__.py" "$work/hostile/hermes_cli/__init__.py"
cd "$work/project"
output=$(PYTHONPATH="$work/hostile" PYTHONHOME="$work/missing-python" /usr/bin/hermes --version)
grep -qF 'Hermes Agent v0.22.2' <<< "$output"
# -P changes import search, not the actual working directory. Exercise that
# exact interpreter mode separately so the isolation cannot hide a chdir fix.
actual=$(PYTHONPATH=/opt/hermes-agent/app /opt/hermes-agent/python/bin/python3 -s -P -c 'import os; print(os.getcwd())')
[[ $actual == "$work/project" ]]
! grep -qE '(^|[;&])[[:space:]]*cd[[:space:]]' /usr/bin/hermes
printf 'Packaged Hermes rejects hostile Python paths and retains project cwd.\n'

# Check the admitted payload through the caller's real access rights. Syntax
# checking parses the terminal frontend without running it or making requests.
unreadable=$(find /opt/hermes-agent \( \( -type f ! -readable \) -o \( -type d \( ! -readable -o ! -executable \) \) \) -print -quit)
[[ -z $unreadable ]] || { printf 'Unreadable Hermes payload: %s\n' "$unreadable" >&2; exit 1; }
node --check /opt/hermes-agent/app/ui-tui/dist/entry.js
printf 'Ordinary users can read the Hermes payload and parse its terminal frontend.\n'
