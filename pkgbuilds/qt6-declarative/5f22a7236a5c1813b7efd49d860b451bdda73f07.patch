From 5f22a7236a5c1813b7efd49d860b451bdda73f07 Mon Sep 17 00:00:00 2001
From: Ulf Hermann <ulf.hermann@qt.io>
Date: Thu, 24 Sep 2026 16:43:49 +0000
Subject: [PATCH] V4: Keep the accumulator intact across the JIT's SetLookup
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

SetLookupSloppy and SetLookupStrict return nothing, but the JIT
retrieved their result into the accumulator. The accumulator then held
whatever the call happened to leave in the return register, and the
next instruction that stored it into the frame exposed that garbage to
the garbage collector. Restore the accumulator after the call instead,
like the interpreter and StoreProperty do.

Pick-to: 6.8
Change-Id: Ibd4a48543367208ad9cb886fd740c637e7d41961
Reviewed-by: Fabian Kosmale <fabian.kosmale@qt.io>
(cherry picked from commit 4c1054b0f997f2977a54d42523856805b309db9a)
Reviewed-by: Olivier De Cannière <olivier.decanniere@qt.io>
---
 src/qml/jit/qv4baselinejit.cpp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/qml/jit/qv4baselinejit.cpp b/src/qml/jit/qv4baselinejit.cpp
index cdb4b8f2674..abea5435a63 100644
--- a/src/qml/jit/qv4baselinejit.cpp
+++ b/src/qml/jit/qv4baselinejit.cpp
@@ -299,9 +299,10 @@ void BaselineJIT::generate_SetLookup(int index, int base)
     as->passJSSlotAsArg(base, 1);
     as->passFunctionAsArg(0);
     if (function->isStrict())
-        BASELINEJIT_GENERATE_RUNTIME_CALL(SetLookupStrict, CallResultDestination::InAccumulator)
+        BASELINEJIT_GENERATE_RUNTIME_CALL(SetLookupStrict, CallResultDestination::Ignore)
     else
-        BASELINEJIT_GENERATE_RUNTIME_CALL(SetLookupSloppy, CallResultDestination::InAccumulator)
+        BASELINEJIT_GENERATE_RUNTIME_CALL(SetLookupSloppy, CallResultDestination::Ignore)
+    LOAD_ACC();
 }
 
 void BaselineJIT::generate_LoadSuperProperty(int property)
